diff --git a/Mathport/Binary/Apply.lean b/Mathport/Binary/Apply.lean
index b3497c3..e1b38f4 100644
--- a/Mathport/Binary/Apply.lean
+++ b/Mathport/Binary/Apply.lean
@@ -99,9 +99,11 @@ def refineAddDecl (decl : Declaration) : BinportM (Declaration × ClashKind) :=
           let decl ← liftMetaM <| stubType decl
           try
             liftCoreM do addDecl decl
-          catch ex =>
-            println! "[addDecl] failed to port {decl.toName}"
-            throw ex
+          catch _ =>
+            -- Binport output is only an intermediate (used for name translation);
+            -- skip this declaration instead of aborting the whole module.
