import Mathlib.GroupTheory.FreeAbelianGroupFinsupp
import Mathlib.Data.Finsupp.Basic

#align_import for_mathlib.free_abelian_group

/-!
In this file we define the equivalence between `free_abelian_group X`
and `X →₀ ℤ` (the type of finitely supported function `X → ℤ`).
Both types come with useful machinery, and the purpose of this file
is to transport some of the machinery from one to the other.

We also define a new induction principle on `free_abelian_group X`,
needed for proving that the maps in `Lbar_complex` compose the way they should.
This induction principle is `induction_on_free_predicate` below.
A `free_predicate` on a free abelian group is a predicate that contains
`a : free_abelian_group X` if and only if it contains all the summands of `a`.
-/


noncomputable section

open scoped BigOperators

namespace FreeAbelianGroup

variable {X : Type _}

open scoped Classical

theorem support_add_smul_of (a : FreeAbelianGroup X) (n : ℤ) (hn : n ≠ 0) (x : X)
    (hxa : x ∉ a.support) : support (a + n • of x) = insert x a.support :=
  by
  apply Finset.Subset.antisymm
  · apply Finset.Subset.trans (support_add _ _)
    intro y
    simp only [Finset.mem_union, Finset.mem_insert, support_zsmul n hn, support_of,
      or_comm' (y = x), Finset.mem_singleton, imp_self]
  · intro y
    simp only [Finset.mem_insert]
    rintro (rfl | hya)
    · rw [not_mem_support_iff] at hxa 
      simp only [coeff, AddMonoidHom.coe_comp, Finsupp.applyAddHom_apply, Function.comp_apply] at
        hxa 
      simp only [support, AddMonoidHom.map_add, Pi.add_apply, Finsupp.mem_support_iff, Ne.def,
        Finsupp.coe_add, hxa, zero_add, AddMonoidHom.map_zsmul, to_finsupp_of]
      rw [← Finsupp.singleAddHom_apply, ← AddMonoidHom.map_zsmul, zsmul_one]
      simpa only [Int.cast_id, Finsupp.single_eq_same, Finsupp.singleAddHom_apply]
    · rw [not_mem_support_iff] at hxa 
      rw [mem_support_iff] at hya 
      simp only [coeff, AddMonoidHom.coe_comp, Finsupp.applyAddHom_apply, Function.comp_apply,
        Ne.def] at hxa hya 
      simp only [support, AddMonoidHom.map_add, Pi.add_apply, Finsupp.mem_support_iff, Ne.def,
        Finsupp.coe_add, AddMonoidHom.map_zsmul, to_finsupp_of]
      rwa [← Finsupp.singleAddHom_apply, ← AddMonoidHom.map_zsmul, zsmul_one,
        Finsupp.singleAddHom_apply, Finsupp.single_apply, if_neg, add_zero]
      rintro rfl; contradiction

theorem support_sum (s : Finset X) (n : X → ℤ) : support (∑ x in s, n x • of x) ⊆ s :=
  by
  apply Finset.induction_on s
  · simp only [Finset.empty_subset, Finset.sum_empty, support_zero]
  intro x s hxs IH
  rw [Finset.sum_insert hxs]
  apply Finset.Subset.trans (support_add _ _)
  by_cases hn : n x = 0
  · simp only [hn, Finset.empty_union, zero_smul, support_zero]
    apply Finset.Subset.trans IH (Finset.subset_insert x s)
  rw [support_zsmul _ hn, support_of]
  intro y hy
  simp only [Finset.mem_union, Finset.mem_singleton] at hy 
  simp only [Finset.mem_insert]
  apply Or.imp id _ hy
  intro h; exact IH h

@[simp]
theorem coeff_of_self (x : X) : coeff x (of x) = 1 := by
  simp only [coeff, AddMonoidHom.coe_comp, Finsupp.applyAddHom_apply, Finsupp.single_eq_same,
    Function.comp_apply, to_finsupp_of]

theorem sum_support_coeff (a : FreeAbelianGroup X) : ∑ x in a.support, coeff x a • of x = a :=
  by
  apply (equiv_finsupp X).Injective
  simp only [equiv_finsupp_apply]
  rw [← Finsupp.sum_single a.to_finsupp, Finsupp.sum]
  simp only [AddMonoidHom.map_sum, AddMonoidHom.map_zsmul, to_finsupp_of]
  apply Finset.sum_congr rfl
  intro x hx
  simp only [← Finsupp.singleAddHom_apply, ← AddMonoidHom.map_zsmul, zsmul_one, coeff, Int.cast_id,
    AddMonoidHom.comp_apply, Finsupp.applyAddHom_apply]

-- probably needs a better name
@[elab_as_elim]
protected theorem induction_on'' {P : FreeAbelianGroup X → Prop} (a : FreeAbelianGroup X) (h0 : P 0)
    (h1 : ∀ (n : ℤ) (h : n ≠ 0) (x), P (n • of x))
    (h2 :
      ∀ (a : FreeAbelianGroup X) (n : ℤ) (hn : n ≠ 0) (x : X) (h : x ∉ a.support),
        P a → (∀ n : ℤ, P (n • of x)) → P (a + n • of x)) :
    P a := by
  rw [← sum_support_coeff a]
  generalize hs : a.support = s
  classical
  apply Finset.induction_on s <;> clear! s
  · simpa only [Finset.sum_empty]
  intro x s hxs IH
  rw [Finset.sum_insert hxs, add_comm]
  by_cases hxa : coeff x a = 0
  · rw [hxa, zero_smul, add_zero]; exact IH
  apply h2 _ _ hxa _ _ IH
  · intro n; by_cases hn : n = 0; · rwa [hn, zero_smul]; exact h1 n hn x
  contrapose! hxs
  apply support_sum _ _ hxs

/-- A `free_predicate` on a free abelian group is a predicate that cuts out a subgroup
generated by a subset of the generators of the free abelian group. -/
def FreePredicate (Q : FreeAbelianGroup X → Prop) :=
  ∀ a : FreeAbelianGroup X, Q a ↔ ∀ x ∈ a.support, Q (of x)

namespace FreePredicate

variable {Q : FreeAbelianGroup X → Prop} {a b : FreeAbelianGroup X}

theorem zero (h : FreePredicate Q) : Q 0 := by
  rw [h]
  simp only [Finset.not_mem_empty, forall_prop_of_false, not_false_iff, support_zero,
    forall_true_iff]

theorem add (h : FreePredicate Q) (ha : Q a) (hb : Q b) : Q (a + b) :=
  by
  rw [h] at ha hb ⊢
  intro x hx
  replace hx := support_add _ _ hx
  simp only [Finset.mem_union] at hx 
  cases hx <;> solve_by_elim

theorem neg (h : FreePredicate Q) (ha : Q a) : Q (-a) :=
  by
  rw [h] at ha ⊢
  intro x hx
  rw [support_neg] at hx 
  solve_by_elim

theorem neg_iff (h : FreePredicate Q) : Q (-a) ↔ Q a :=
  ⟨fun ha => by simpa only [neg_neg] using h.neg ha, h.neg⟩

/--
The additive subgroup of elements of `free_abelian_group X` satisfying a given `free_predicate`. -/
def addSubgroup (h : FreePredicate Q) : AddSubgroup (FreeAbelianGroup X)
    where
  carrier := {a | Q a}
  zero_mem' := h.zero
  add_mem' a b ha hb := h.add ha hb
  neg_mem' a ha := h.neg ha

theorem zsmul (h : FreePredicate Q) (n : ℤ) (ha : Q a) : Q (n • a) :=
  AddSubgroup.zsmul_mem h.AddSubgroup ha n

theorem of_zsmul (h : FreePredicate Q) (n : ℤ) (hn : n ≠ 0) (ha : Q (n • a)) : Q a := by
  rw [h] at ha ⊢; simpa only [support_zsmul n hn] using ha

theorem zsmul_iff (h : FreePredicate Q) (n : ℤ) (hn : n ≠ 0) : Q (n • a) ↔ Q a :=
  ⟨h.of_zsmul n hn, h.zsmul n⟩

theorem smul (h : FreePredicate Q) (n : ℤ) (ha : Q a) : Q (n • a) := by rw [← zsmul_eq_smul];
  apply h.zsmul _ ha

theorem of_smul (h : FreePredicate Q) (n : ℤ) (hn : n ≠ 0) (ha : Q (n • a)) : Q a := by
  rwa [h.zsmul_iff n hn] at ha 

theorem smul_iff (h : FreePredicate Q) (n : ℤ) (hn : n ≠ 0) : Q (n • a) ↔ Q a :=
  ⟨h.of_smul n hn, h.smul n⟩

theorem smul_nat (h : FreePredicate Q) (n : ℕ) (ha : Q a) : Q (n • a) :=
  h.smul n ha

theorem of_smul_nat (h : FreePredicate Q) (n : ℕ) (hn : n ≠ 0) (ha : Q (n • a)) : Q a :=
  h.of_smul n (by exact_mod_cast hn) ha

theorem smul_nat_iff (h : FreePredicate Q) (n : ℕ) (hn : n ≠ 0) : Q (n • a) ↔ Q a :=
  ⟨h.of_smul_nat n hn, h.smul_nat n⟩

end FreePredicate

/-- An induction principle for elements of `free_abelian_group X`
satisfying some `free_predicate Q`. -/
@[elab_as_elim]
protected theorem induction_on_freePredicate {P : FreeAbelianGroup X → Prop}
    (Q : FreeAbelianGroup X → Prop) (hQ : FreePredicate Q) (a : FreeAbelianGroup X) (hQa : Q a)
    (hP0 : P 0) (hof : ∀ x, Q (of x) → P (of x)) (hneg : ∀ a, Q a → P a → P (-a))
    (hadd : ∀ a b, Q a → Q b → P a → P b → P (a + b)) : P a :=
  by
  revert hQa
  have N : ∀ (n : ℕ) (x), Q (n • of x) → P (n • of x) :=
    by
    intro n x
    induction' n with n ih
    · intro; exact hP0
    · intro hQx
      have hQ1x : Q (of x) := hQ.of_smul_nat n.succ n.succ_ne_zero hQx
      have hQnx : Q (n • of x) := hQ.smul_nat n hQ1x
      rw [Nat.succ_eq_add_one, add_smul, one_smul]
      apply hadd _ _ hQnx hQ1x (ih hQnx) (hof _ hQ1x)
  apply FreeAbelianGroup.induction_on'' a
  · intro; exact hP0
  · intro n hn x
    cases' le_or_lt 0 n with h0n hn0
    · lift n to ℕ using h0n; apply N
    · have h0n : 0 ≤ -n := by rw [neg_nonneg]; exact hn0.le
      lift -n to ℕ using h0n with k hk
      intro hQx
      have hQ1x : Q (of x) := hQ.of_smul n hn hQx
      rw [← neg_neg n, neg_smul]
      apply hneg _ (hQ.smul _ hQ1x)
      rw [← hk]
      exact N _ _ (hQ.smul_nat k hQ1x)
  · intro a n hn x hxa IH1 IH2 hq
    have hQa : Q a := by
      rw [hQ] at hq ⊢; intro x hxa'; apply hq; rw [support_add_smul_of _ _ hn _ hxa]
      apply Finset.mem_insert_of_mem hxa'
    have hQx : Q (of x) := by
      rw [hQ] at hq ⊢; intro x' hxa'; apply hq; rw [support_add_smul_of _ _ hn _ hxa]
      rw [support_of, Finset.mem_singleton] at hxa' ; subst hxa'
      apply Finset.mem_insert_self
    exact hadd _ _ hQa (hQ.smul n hQx) (IH1 hQa) (IH2 n (hQ.smul n hQx))

theorem mem_support_map {X Y : Type _} (f : X → Y) (hf : Function.Injective f)
    (a : FreeAbelianGroup X) (y : Y) : y ∈ (map f a).support ↔ ∃ x, x ∈ a.support ∧ y = f x :=
  by
  revert y
  apply FreeAbelianGroup.induction_on'' a <;> clear a
  · intro y
    simp only [Finset.not_mem_empty, exists_false, support_zero, AddMonoidHom.map_zero,
      false_and_iff]
  · intro n hn x y
    simp only [hn, AddMonoidHom.map_zsmul, map_of_apply, support_zsmul, support_of, exists_eq_left,
      Ne.def, not_false_iff, Finset.mem_singleton]
  · rintro a n hn x hx IH - y
    simp only [AddMonoidHom.map_zsmul, AddMonoidHom.map_add, map_of_apply,
      support_add_smul_of _ _ hn _ hx]
    rw [support_add_smul_of _ _ hn]
    · simp only [IH, Finset.mem_insert]
      constructor
      · rintro (rfl | ⟨x', h, rfl⟩)
        · exact ⟨x, Or.inl rfl, rfl⟩
        · exact ⟨x', Or.inr h, rfl⟩
      · rintro ⟨x', rfl | h, rfl⟩
        · exact Or.inl rfl
        · exact Or.inr ⟨x', h, rfl⟩
    · simp only [IH, not_exists, not_and]
      intro x' hx'
      apply hf.ne
      rintro rfl
      exact hx hx'

end FreeAbelianGroup

