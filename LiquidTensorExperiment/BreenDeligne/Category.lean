import Mathlib.Algebra.Homology.Additive
import Mathlib.Algebra.Homology.HomologicalComplex
import LiquidTensorExperiment.ForMathlib.FreeAbelianGroup
import LiquidTensorExperiment.ForMathlib.FreeAb
import LiquidTensorExperiment.BreenDeligne.UniversalMap

#align_import breen_deligne.category

/-!

# The category of Breen-Deligne data

This file defines the category whose objects are the natural numbers
and whose morphisms `m ⟶ n` are functorial maps `φ_A : ℤ[A^m] → ℤ[A^n]`.

-/


open scoped BigOperators Kronecker

namespace BreenDeligne

open FreeAbelianGroup CategoryTheory

/-- The category whose objects are natural numbers
and whose morphisms are matrices with integer coefficients. -/
def Mat :=
  ℕ
deriving CommSemiring

namespace Mat

instance : SmallCategory Mat where
  Hom m n := BasicUniversalMap m n
  id := BasicUniversalMap.id
  comp f g := BasicUniversalMap.comp g f
  id_comp f := BasicUniversalMap.comp_id f
  comp_id f := BasicUniversalMap.id_comp f
  assoc f g h := (BasicUniversalMap.comp_assoc h g f).symm

end Mat

/-- The category whose objects are natural numbers
and whose morphisms are the free abelian groups generated by
matrices with integer coefficients. -/
def FreeMat :=
  ℕ
deriving CommSemiring

namespace FreeMat

instance : SmallCategory FreeMat where
  Hom m n := UniversalMap m n
  id := UniversalMap.id
  comp f g := UniversalMap.comp g f
  id_comp f := UniversalMap.comp_id f
  comp_id f := UniversalMap.id_comp f
  assoc f g h := (UniversalMap.comp_assoc h g f).symm

-- Porting note: instance search does not unfold `m ⟶ n`, so the group structure on the
-- hom-types is provided explicitly.
instance homAddCommGroup (m n : FreeMat) : AddCommGroup (m ⟶ n) :=
  inferInstanceAs (AddCommGroup (UniversalMap m n))

instance : Preadditive FreeMat where
  homGroup m n := inferInstance
  add_comp l m n f g h := AddMonoidHom.map_add _ _ _
  comp_add l m n f g h :=
    show UniversalMap.comp (g + h) f = _ by rw [AddMonoidHom.map_add, AddMonoidHom.add_apply]; rfl

def toFreeAbMat : FreeMat ⥤ FreeAb Mat
    where
  obj n := FreeAb.of n
  map f := f
  map_id m := rfl
  -- Porting note: the Lean 3 proof (induction on `f` and `g`) is replaced by a two-variable
  -- extensionality argument, since `simp` does not see through the two category structures.
  map_comp {X Y Z} f g :=
    FunLike.congr_fun
      (FunLike.congr_fun
        (freeAbelianGroup_ext₂
          (α := BasicUniversalMap X Y) (β := BasicUniversalMap Y Z) (γ := UniversalMap X Z)
          (UniversalMap.comp (l := X) (m := Y) (n := Z)).flip
          (FreeAb.comp (X := FreeAb.of (C := Mat) X) (Y := FreeAb.of (C := Mat) Y)
            (Z := FreeAb.of (C := Mat) Z))
          (fun a b => (UniversalMap.comp_of b a).trans (FreeAb.comp_of_of Mat a b).symm)) f) g

open UniversalMap

@[simps]
def mulFunctor (N : ℕ) : FreeMat ⥤ FreeMat
    where
  -- Porting note: explicit `ℕ` ascription, since `FreeMat` is a def and `HMul ℕ FreeMat` is not found
  obj n := (N * (show ℕ from n) : ℕ)
  map f := mul N f
  map_id n :=
    (FreeAbelianGroup.map_of _ _).trans <|
      congr_arg _ <| by
        dsimp [BasicUniversalMap.mul, BasicUniversalMap.id]
        ext i j
        simp only [Matrix.one_kronecker_one, Matrix.submatrix_apply, Matrix.one_apply,
          Equiv.apply_eq_iff_eq, eq_self_iff_true]
  map_comp f g := hMul_comp _ _ _

instance mulFunctor.additive (N : ℕ) : (mulFunctor N).Additive
    where map_add := AddMonoidHom.map_add _ _ _

@[simps]
def isoMk' {m n : FreeMat} (f : BasicUniversalMap m n) (g : BasicUniversalMap n m)
    (hfg : BasicUniversalMap.comp g f = BasicUniversalMap.id _)
    (hgf : BasicUniversalMap.comp f g = BasicUniversalMap.id _) : m ≅ n
    where
  hom := of f
  inv := of g
  hom_inv_id := (comp_of _ _).trans <| congr_arg _ <| hfg
  inv_hom_id := (comp_of _ _).trans <| congr_arg _ <| hgf

def oneMulIso : mulFunctor 1 ≅ 𝟭 _ :=
  NatIso.ofComponents
    (fun n =>
      isoMk' (BasicUniversalMap.oneMulHom _) (BasicUniversalMap.oneMulInv _)
        BasicUniversalMap.oneMulInv_hom BasicUniversalMap.oneMulHom_inv)
    (by
      intro m n f
      dsimp
      show UniversalMap.comp _ _ = UniversalMap.comp _ _
      -- Porting note: the Lean 3 proof rewrote with `add_monoid_hom.flip_apply` and used `ext1`;
      -- here we argue by induction on `f` instead.
      induction f using FreeAbelianGroup.induction_on with
      | C0 => simp only [map_zero, AddMonoidHom.zero_apply]
      | C1 f =>
        have :
          f =
            Matrix.reindexLinearEquiv ℕ _
              ((finOneEquiv.prodCongr <| Equiv.refl _).trans <| Equiv.punitProd _)
              ((finOneEquiv.prodCongr <| Equiv.refl _).trans <| Equiv.punitProd _) (1 ⊗ₖ f) := by
          ext i j; dsimp [Matrix.kroneckerMap, Matrix.one_apply]
          simp only [one_mul, if_true, eq_iff_true_of_subsingleton]
        conv_rhs => rw [this]
        simp only [comp_of, hMul_of, BasicUniversalMap.comp, AddMonoidHom.mk'_apply,
          BasicUniversalMap.mul, BasicUniversalMap.oneMulHom, AddMonoidHom.compHom_apply_apply,
          AddMonoidHom.comp_apply, AddMonoidHom.flip_apply, BreenDeligne.FreeMat.isoMk'_hom]
        rw [Matrix.reindexLinearEquiv_mul, Matrix.reindexLinearEquiv_mul, Matrix.one_mul,
          Matrix.mul_one]
      | Cn f ih => simp only [map_neg, AddMonoidHom.neg_apply, ih]
      | Cp f₁ f₂ ih₁ ih₂ => simp only [map_add, AddMonoidHom.add_apply, ih₁, ih₂])

/-
Should `kronecker_reindex_left` and `kronecker_reindex_right` land into `mathlib`?
-/
variable {α β γ : Type _}

variable {l₁ m₁ n₁ l₂ m₂ n₂ : Type _}

variable [Fintype l₁] [Fintype m₁] [Fintype n₁]

variable [Fintype l₂] [Fintype m₂] [Fintype n₂]

theorem kroneckerMap_reindex_left (f : α → β → γ) (el : l₁ ≃ l₂) (em : m₁ ≃ m₂) (M : Matrix l₁ m₁ α)
    (N : Matrix n₁ n₂ β) :
    Matrix.kroneckerMap f (Matrix.reindex el em M) N =
      Matrix.reindex (el.prodCongr (Equiv.refl _)) (em.prodCongr (Equiv.refl _))
        (Matrix.kroneckerMap f M N) :=
  by ext ⟨i, i'⟩ ⟨j, j'⟩; rfl

theorem kroneckerMap_reindex_right (f : α → β → γ) (em : m₁ ≃ m₂) (en : n₁ ≃ n₂)
    (M : Matrix l₁ l₂ α) (N : Matrix m₁ n₁ β) :
    Matrix.kroneckerMap f M (Matrix.reindex em en N) =
      Matrix.reindex ((Equiv.refl _).prodCongr em) ((Equiv.refl _).prodCongr en)
        (Matrix.kroneckerMap f M N) :=
  by ext ⟨i, i'⟩ ⟨j, j'⟩; rfl

theorem hMul_hMul_iso_aux (m n i j : ℕ) (f : BasicUniversalMap i j) :
    (comp (of (BasicUniversalMap.mulMulHom m n j))) (mul m (mul n (of f))) =
      comp (mul (m * n) (of f)) (of (BasicUniversalMap.mulMulHom m n i)) :=
  by
  simp only [comp_of, hMul_of, BasicUniversalMap.comp, AddMonoidHom.mk'_apply,
    BasicUniversalMap.mul, BasicUniversalMap.mulMulHom, Matrix.mul_reindexLinearEquiv_one]
  rw [Matrix.reindexLinearEquiv_mul, Matrix.one_mul, ←
    Matrix.reindexLinearEquiv_one ℕ _ (@finProdFinEquiv m n)]
  simp only [Matrix.reindexLinearEquiv_apply]
  rw [kroneckerMap_reindex_left, kroneckerMap_reindex_right, ← Matrix.kronecker_assoc]
  simp only [← Equiv.trans_apply, Matrix.reindex_trans, Matrix.one_kronecker_one, Equiv.trans_refl]
  congr 3
  · ext ⟨⟨a, b⟩, c⟩
    simp only [Equiv.trans_apply, Equiv.symm_apply_apply, Equiv.apply_symm_apply,
      Equiv.prodAssoc_apply, Equiv.prodAssoc_symm_apply, Equiv.prodCongr_apply, Prod.map_def,
      Equiv.refl_apply]
  · ext ⟨⟨a, b⟩, c⟩
    simp only [Equiv.trans_apply, Equiv.symm_apply_apply, Equiv.apply_symm_apply,
      Equiv.prodAssoc_apply, Equiv.prodAssoc_symm_apply, Equiv.prodCongr_apply, Prod.map_def,
      Equiv.refl_apply, Equiv.symm_trans_apply, Equiv.symm_symm, Equiv.prodCongr_symm,
      Equiv.refl_symm]

def mulMulIso (m n : ℕ) : mulFunctor n ⋙ mulFunctor m ≅ mulFunctor (m * n) :=
  NatIso.ofComponents
    (fun i =>
      isoMk' (BasicUniversalMap.mulMulHom m n i) (BasicUniversalMap.mulMulInv m n i)
        BasicUniversalMap.mulMulInv_hom BasicUniversalMap.mulMulHom_inv)
    (by
      intro i j f
      dsimp
      show UniversalMap.comp _ _ = UniversalMap.comp _ _
      -- Porting note: the Lean 3 proof rewrote with `add_monoid_hom.flip_apply` and used `ext1`;
      -- here we argue by induction on `f` instead.
      induction f using FreeAbelianGroup.induction_on with
      | C0 => simp only [map_zero, AddMonoidHom.zero_apply]
      | C1 f => exact BreenDeligne.FreeMat.hMul_hMul_iso_aux _ _ _ _ f
      | Cn f ih => simp only [map_neg, AddMonoidHom.neg_apply, ih]
      | Cp f₁ f₂ ih₁ ih₂ => simp only [map_add, AddMonoidHom.add_apply, ih₁, ih₂])

end FreeMat

/-- Roughly speaking, this is a collection of formal finite sums of matrices
that encode the data that rolls out of the Breen--Deligne resolution. -/
def Data :=
  ChainComplex FreeMat ℕ

-- Porting note: the `deriving` handler fails for `Preadditive`, so both instances are given by hand.
instance : SmallCategory Data :=
  inferInstanceAs (SmallCategory (ChainComplex FreeMat ℕ))

instance : Preadditive Data :=
  inferInstanceAs (Preadditive (ChainComplex FreeMat ℕ))

namespace Data

variable (BD : Data)

section Mul

open UniversalMap

@[simps]
def mul (N : ℕ) : Data ⥤ Data :=
  (FreeMat.mulFunctor N).mapHomologicalComplex _

def mulOneIso : (mul 1).obj BD ≅ BD :=
  HomologicalComplex.Hom.isoOfComponents (fun i => FreeMat.oneMulIso.app _) fun i j _ =>
    (FreeMat.oneMulIso.hom.naturality (BD.d i j)).symm

def mulMulIso (m n : ℕ) : (mul m).obj ((mul n).obj BD) ≅ (mul (m * n)).obj BD :=
  HomologicalComplex.Hom.isoOfComponents (fun i => (FreeMat.mulMulIso _ _).app _) fun i j _ =>
    ((FreeMat.mulMulIso _ _).hom.naturality (BD.d i j)).symm

end Mul

/-- `BD.pow N` is the Breen--Deligne data whose `n`-th rank is `2^N * BD.rank n`. -/
def pow' : ℕ → Data
  | 0 => BD
  | n + 1 => (mul 2).obj (pow' n)

@[simps]
def sum (BD : Data) (N : ℕ) : (mul N).obj BD ⟶ BD
    where
  f n := UniversalMap.sum _ _
  comm' m n _ := (UniversalMap.sum_comp_hMul _ _).symm

@[simps]
def proj (BD : Data) (N : ℕ) : (mul N).obj BD ⟶ BD
    where
  f n := UniversalMap.proj _ _
  comm' m n _ := (UniversalMap.proj_comp_hMul _ _).symm

open HomologicalComplex FreeMat CategoryTheory CategoryTheory.Limits

def homPow' {BD : Data} (f : (mul 2).obj BD ⟶ BD) : ∀ N, BD.pow' N ⟶ BD
  | 0 => 𝟙 _
  | n + 1 => (mul 2).map (BreenDeligne.Data.homPow' f n) ≫ f

open scoped ZeroObject

-- Porting note: in Lean 4, `2 ^ (N + 1)` is not definitionally equal to `2 * 2 ^ N`, so the
-- iso `(mul (2 * 2 ^ N)).obj BD ≅ (mul (2 ^ (N + 1))).obj BD` is inserted explicitly.
def mulCongr {a b : ℕ} (h : a = b) : (mul a).obj BD ≅ (mul b).obj BD :=
  eqToIso (congrArg (fun k => (mul k).obj BD) h)

theorem mulCongr_hom_sum {a b : ℕ} (h : a = b) : (BD.mulCongr h).hom ≫ BD.sum b = BD.sum a := by
  subst h
  simp [mulCongr]

theorem mulCongr_hom_proj {a b : ℕ} (h : a = b) : (BD.mulCongr h).hom ≫ BD.proj b = BD.proj a := by
  subst h
  simp [mulCongr]

def pow'IsoMul : ∀ N, BD.pow' N ≅ (mul (2 ^ N)).obj BD
  | 0 => BD.mulOneIso.symm
  | N + 1 =>
    show (mul 2).obj (BD.pow' N) ≅ (mul (2 ^ (N + 1))).obj BD from
      (mul 2).mapIso (pow'IsoMul N) ≪≫ mulMulIso _ _ _ ≪≫ BD.mulCongr (pow_succ 2 N).symm

theorem homPow'_sum : ∀ N, (BD.pow'IsoMul N).inv ≫ homPow' (BD.sum 2) N = BD.sum (2 ^ N)
  | 0 => by
    apply HomologicalComplex.hom_ext
    intro n
    simp only [BreenDeligne.Data.homPow', Category.comp_id]
    show (BD.pow'IsoMul 0).inv.f n = (BD.sum 1).f n
    dsimp only [sum_f, UniversalMap.sum]
    simp only [Fin.default_eq_zero, Finset.univ_unique, Finset.sum_singleton]
    refine' congr_arg of _
    apply BasicUniversalMap.oneMulHom_eq_proj
  | N + 1 => by
    dsimp [pow'IsoMul, BreenDeligne.Data.homPow']
    slice_lhs 3 4 => rw [← Functor.map_comp, homPow'_sum N]
    rw [Iso.inv_comp_eq, BD.mulCongr_hom_sum]
    apply HomologicalComplex.hom_ext
    intro i
    iterate 2 erw [HomologicalComplex.comp_f]
    dsimp [mulMulIso, FreeMat.mulMulIso, UniversalMap.sum]
    rw [UniversalMap.hMul_of]
    show UniversalMap.comp _ _ = UniversalMap.comp _ _
    simp only [UniversalMap.comp_of, AddMonoidHom.map_sum, AddMonoidHom.finset_sum_apply]
    congr 1
    rw [← Finset.sum_product', Finset.univ_product_univ, ← fin_prod_fin_equiv.symm.sum_comp]
    apply Fintype.sum_congr
    apply BasicUniversalMap.comp_proj_hMul_proj

theorem homPow'_sum' (N : ℕ) : homPow' (BD.sum 2) N = (BD.pow'IsoMul N).hom ≫ BD.sum (2 ^ N) := by
  rw [← Iso.inv_comp_eq]; apply BreenDeligne.Data.homPow'_sum

theorem homPow'_proj : ∀ N, (BD.pow'IsoMul N).inv ≫ homPow' (BD.proj 2) N = BD.proj (2 ^ N)
  | 0 => by
    apply HomologicalComplex.hom_ext
    intro n
    simp only [BreenDeligne.Data.homPow', Category.comp_id]
    show (BD.pow'IsoMul 0).inv.f n = (BD.proj 1).f n
    dsimp only [proj_f, UniversalMap.proj]
    refine' congr_arg of _
    apply BasicUniversalMap.oneMulHom_eq_proj
  | N + 1 => by
    dsimp [pow'IsoMul, BreenDeligne.Data.homPow']
    slice_lhs 3 4 => rw [← Functor.map_comp, homPow'_proj N]
    rw [Iso.inv_comp_eq]
    apply HomologicalComplex.hom_ext
    intro i
    iterate 2 erw [HomologicalComplex.comp_f]
    dsimp [mulMulIso, FreeMat.mulMulIso, UniversalMap.proj]
    simp only [AddMonoidHom.map_sum, AddMonoidHom.finset_sum_apply, Preadditive.comp_sum,
      Preadditive.sum_comp]
    rw [← Finset.sum_comm, ← Finset.sum_product', Finset.univ_product_univ, ←
      fin_prod_fin_equiv.symm.sum_comp]
    apply Fintype.sum_congr
    intro j
    rw [UniversalMap.hMul_of]
    show UniversalMap.comp _ _ = UniversalMap.comp _ _
    simp only [UniversalMap.comp_of, BasicUniversalMap.comp_proj_hMul_proj]

theorem homPow'_proj' (N : ℕ) : homPow' (BD.proj 2) N = (BD.pow'IsoMul N).hom ≫ BD.proj (2 ^ N) :=
  by rw [← Iso.inv_comp_eq]; apply BreenDeligne.Data.homPow'_proj

end Data

end BreenDeligne

